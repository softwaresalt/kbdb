# Rust
target/
Cargo.lock.bak

# Transient output files (logs, test results, lint reports)
logs/
docs/scratch/

# C extensions
*.so

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py.cover
.hypothesis/
.pytest_cache/
cover/

# Translations
*.mo
*.pot

# UV
#   Similar to Pipfile.lock, it is generally recommended to include uv.lock in version control.
#   This is especially recommended for binary packages to ensure reproducibility, and is more
#   commonly ignored for libraries.
#uv.lock

# Celery stuff
celerybeat-schedule
celerybeat.pid

# Local environment files (secrets) — never commit. Only .env.example may be tracked.
.env
.env.local
.env.*.local
.envrc
.venv
.mcp.json
.sandbox/
env/
venv/
ENV/
env.bak/
venv.bak/
.copilot/
.copilot-tracking/
.cargo-home/
.tmp-build/
.scripts/__pycache__/
.github/copilot/

# mkdocs documentation
/site

# Abstra
# Abstra is an AI-powered process automation framework.
# Ignore directories containing user credentials, local state, and settings.
# Learn more at https://abstra.io/docs
.abstra/

# Visual Studio Code
#  Visual Studio Code specific template is maintained in a separate VisualStudioCode.gitignore 
#  that can be found at https://github.com/github/gitignore/blob/main/Global/VisualStudioCode.gitignore
#  and can be added to the global gitignore or merged into this file. However, if you prefer, 
#  you could uncomment the following to ignore the entire vscode folder
# .vscode/

# Ruff stuff:
.ruff_cache/

# Engram runtime data (keep templates/, registry.yaml, .version)
.engram/*
!.engram/.version
!.engram/.workspace-id
!.engram/config.toml
!.engram/registry.yaml

# Logs and temp files
*.log
*.tmp
*.swp
*.txt
logs/
temp/
tmp/
*.txt
!tools/t4-capture/requirements.txt
!tools/t4-capture/fixtures/*.txt
__pycache__/

# Cursor
#  Cursor is an AI-powered code editor. `.cursorignore` specifies files/directories to
#  exclude from AI features like autocomplete and code analysis. Recommended for sensitive data
#  refer to https://docs.cursor.com/context/ignore-files
.cursorignore
.cursorindexingignore

# UE
*.prj
*.pui

# autoharness
.autoharness/backups/
.autoharness/staging/

# kbdb workspace runtime (databases, state, cloned data)
.kbdb/*.db
.kbdb/sync_state.json
.kbdb/data/
.kbdb/bin/
.kbdb/cache/
.kbdb/logs/
.kbdb/config/sources.yaml

# backlogit runtime artifacts
.backlogit/backlogit.db
.backlogit/*.db-shm
.backlogit/*.db-wal
.backlogit/*.db-journal
.backlogit/logs/
.backlogit/runtime/
.backlogit/.locks/

# kbdb — managed by kbdb install
.kbdb/

# Agent lock files (autoharness file-lock skill)
.*.lock
**/.*.lock
